<Window x:Class="Kopilka.FinanceManager.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в Копилку" Height="350" Width="400" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="ВХОД" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20" />

            <TextBlock Text="Логин:" Margin="0,10,0,5" />
            <TextBox x:Name="LoginBox" Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" Padding="5" />

            <TextBlock Text="Пароль:" Margin="0,10,0,5" />
            <PasswordBox x:Name="PasswordBox" Padding="5" PasswordChanged="PasswordBox_PasswordChanged" />

            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" Margin="0,10,0,0" HorizontalAlignment="Center" />

            <UniformGrid Columns="2" Margin="0,20,0,0">
                <Button Content="Войти" Command="{Binding LoginCommand}" Margin="5" Padding="10" />
                <Button Content="Регистрация" Command="{Binding RegisterCommand}" Margin="5" Padding="10" />
            </UniformGrid>
        </StackPanel>
    </Grid>
</Window>
