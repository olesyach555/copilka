<Window x:Class="Kopilka.FinanceManager.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kopilka.FinanceManager"
        mc:Ignorable="d"
        Title="Kopilka - Вход" Height="450" Width="400"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Border CornerRadius="10" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="20" Margin="20" Background="Transparent">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Вход в Копилку" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="{StaticResource TextForeground}"/>

                <Grid x:Name="LoginGrid">
                    <StackPanel>
                        <TextBlock Text="Логин:" Margin="0,0,0,5"/>
                        <TextBox x:Name="LoginTextBox" TextChanged="Input_TextChanged"/>

                        <TextBlock Text="Пароль:" Margin="0,10,0,5"/>
                        <PasswordBox x:Name="PasswordBox" PasswordChanged="Password_PasswordChanged"/>

                        <TextBlock Text="Подтвердите пароль:" Margin="0,10,0,5"/>
                        <PasswordBox x:Name="ConfirmPasswordBox" PasswordChanged="Password_PasswordChanged"/>

                        <!-- Панель для вывода ошибок (стилизуем под темную тему) -->
                        <Border x:Name="ErrorBorder" Background="#4d3e00" BorderBrush="#ffcc00" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,10,0,10" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ErrorTextBlock" Foreground="#ffeb99" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                <Button x:Name="CloseErrorButton" Grid.Column="1" Content="X" FontWeight="Bold" Foreground="#ffeb99" Background="Transparent" BorderThickness="0" Width="20" Height="20" VerticalAlignment="Top" HorizontalAlignment="Right" Click="CloseErrorButton_Click"/>
                            </Grid>
                        </Border>

                        <Button x:Name="LoginButton" Content="Войти" Margin="0,10,0,0" Style="{StaticResource PrimaryButton}" Click="LoginButton_Click"/>
                        <Button x:Name="RegisterButton" Content="Регистрация" Margin="0,10,0,0" Style="{StaticResource SecondaryButton}" Click="RegisterButton_Click"/>
                    </StackPanel>
                </Grid>
                <Button x:Name="LogoutButton" Content="Выйти" Margin="0,10,0,0" Style="{StaticResource PrimaryButton}" Click="LogoutButton_Click" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
