<Window x:Class="Kopilka.FinanceManager.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Смена пароля" Height="350" Width="300"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Смена пароля" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="Старый пароль" Foreground="Gray" Margin="0,0,0,5"/>
            <PasswordBox x:Name="OldPasswordBox" FontSize="18" Padding="5"/>

            <TextBlock Text="Новый пароль" Foreground="Gray" Margin="0,15,0,5"/>
            <PasswordBox x:Name="NewPasswordBox" FontSize="18" Padding="5"/>

            <TextBlock Text="Подтвердите новый пароль" Foreground="Gray" Margin="0,15,0,5"/>
            <PasswordBox x:Name="ConfirmPasswordBox" FontSize="18" Padding="5"/>
        </StackPanel>

        <Button Grid.Row="2" x:Name="SavePasswordButton" Content="Сохранить" Click="SavePasswordButton_Click" FontSize="18" Padding="10"/>
    </Grid>
</Window>
