<Window x:Class="Kopilka.FinanceManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Kopilka.BusinessLogic.ViewModels;assembly=Kopilka.BusinessLogic"
        xmlns:views="clr-namespace:Kopilka.FinanceManager.Views.Pages"
        Title="Копилка" Height="600" Width="900" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Левая панель навигации -->
        <StackPanel Grid.Column="0" Background="{StaticResource BgSecondaryDarkBrush}">
            <TextBlock Text="КОПИЛКА" Foreground="White" FontSize="24" FontWeight="Bold" Margin="20" HorizontalAlignment="Center" />

            <Button Content="Журнал" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateToTransactionsCommand}" />
            <Button Content="Долги" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateToDebtsCommand}" />
            <Button Content="Цели" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateToGoalsCommand}" />
            <Button Content="Напоминания" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateToRemindersCommand}" />

            <Separator Margin="10" />
            <Button Content="Выход" Style="{StaticResource NavButtonStyle}" Click="Logout_Click" />
        </StackPanel>

        <!-- Основной контент -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}">
            <ContentControl.Resources>
                <DataTemplate DataType="{x:Type vm:TransactionsViewModel}">
                    <views:TransactionHistoryView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:DebtsViewModel}">
                    <views:DebtsView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:GoalsViewModel}">
                    <views:GoalsView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:RemindersViewModel}">
                    <views:RemindersView />
                </DataTemplate>
            </ContentControl.Resources>
        </ContentControl>
    </Grid>
</Window>
