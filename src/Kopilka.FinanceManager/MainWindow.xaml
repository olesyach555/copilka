<Window x:Class="Kopilka.FinanceManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kopilka.FinanceManager"
        mc:Ignorable="d"
        Title="Kopilka - Вход" Height="450" Width="400"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Border CornerRadius="10" BorderBrush="LightGray" BorderThickness="1" Padding="20" Margin="20">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Вход в Копилку" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Text="Логин:" Margin="0,0,0,5"/>
                <TextBox x:Name="LoginTextBox" Padding="5" TextChanged="Input_TextChanged"/>

                <TextBlock Text="Пароль:" Margin="0,10,0,5"/>
                <PasswordBox x:Name="PasswordBox" Padding="5" PasswordChanged="Password_PasswordChanged"/>

                <TextBlock Text="Подтвердите пароль:" Margin="0,10,0,5"/>
                <PasswordBox x:Name="ConfirmPasswordBox" Padding="5" PasswordChanged="Password_PasswordChanged"/>

                <!-- Панель для вывода ошибок -->
                <Border x:Name="ErrorBorder" Background="#FFF9EBEB" BorderBrush="#FFED9A9A" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,10,0,10" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ErrorTextBlock" Foreground="#FFD9534F" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <Button x:Name="CloseErrorButton" Grid.Column="1" Content="X" FontWeight="Bold" Foreground="#FFD9534F" Background="Transparent" BorderThickness="0" Width="20" Height="20" VerticalAlignment="Top" HorizontalAlignment="Right" Click="CloseErrorButton_Click"/>
                    </Grid>
                </Border>

                <Button x:Name="LoginButton" Content="Войти" Padding="10" Margin="0,10,0,0" Click="LoginButton_Click"/>
                <Button x:Name="RegisterButton" Content="Регистрация" Padding="10" Margin="0,10,0,0" Click="RegisterButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
