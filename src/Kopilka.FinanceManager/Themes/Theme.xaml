<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Цветовая палитра -->

    <!-- Фоны -->
    <SolidColorBrush x:Key="BgPrimaryLight" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BgPrimaryDark" Color="#00171F"/>
    <SolidColorBrush x:Key="BgSecondaryDark" Color="#003459"/>
    <SolidColorBrush x:Key="BgAccent" Color="#007EA7"/>

    <!-- Текст -->
    <SolidColorBrush x:Key="TextOnLight" Color="#000000"/>
    <SolidColorBrush x:Key="TextOnDark" Color="#FFFFFF"/>

    <!-- Границы -->
    <SolidColorBrush x:Key="BorderOnLight" Color="#000000"/>
    <SolidColorBrush x:Key="BorderOnDark" Color="#FFFFFF"/>

    <!-- Ресурсы для тёмной темы (по умолчанию) -->
    <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource ResourceKey=BgPrimaryDark}"/>
    <SolidColorBrush x:Key="TextForeground" Color="{StaticResource ResourceKey=TextOnDark}"/>
    <SolidColorBrush x:Key="BorderColor" Color="{StaticResource ResourceKey=BorderOnDark}"/>

    <!-- Глобальные (неявные) стили -->

    <Style TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource WindowBackground}"/>
    </Style>

    <Style TargetType="Page">
        <Setter Property="Background" Value="{DynamicResource WindowBackground}"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextForeground}"/>
    </Style>

    <!-- Стили для полей ввода -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource BgSecondaryDark}"/>
        <Setter Property="Foreground" Value="{StaticResource TextOnDark}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="5"/>
    </Style>

     <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource BgSecondaryDark}"/>
        <Setter Property="Foreground" Value="{StaticResource TextOnDark}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="5"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource BgSecondaryDark}"/>
        <Setter Property="Foreground" Value="{StaticResource TextOnDark}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="Background" Value="{StaticResource BgSecondaryDark}"/>
        <Setter Property="Foreground" Value="{StaticResource TextOnDark}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style TargetType="ListView">
        <Setter Property="Background" Value="{StaticResource BgSecondaryDark}"/>
        <Setter Property="Foreground" Value="{StaticResource TextOnDark}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Стили кнопок -->

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BgPrimaryDark}"/>
        <Setter Property="Foreground" Value="{StaticResource TextOnDark}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="24,12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BgSecondaryDark}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource BgAccent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BgPrimaryLight}"/>
        <Setter Property="Foreground" Value="{StaticResource TextOnLight}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderOnLight}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="24,12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
         <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#E0E0E0"/> <!-- Слегка серый для наведения -->
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Другие стили -->
    <Style TargetType="TabItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Border" BorderThickness="0,0,0,2" BorderBrush="Transparent" Margin="5">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,5"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource BgAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="{StaticResource TextOnDark}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

</ResourceDictionary>
