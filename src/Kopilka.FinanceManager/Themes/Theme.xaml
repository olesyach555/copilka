<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Цвета как ресурсы Color -->
    <Color x:Key="WindowBackground">#a9d6e5</Color>
    <Color x:Key="BgSecondaryDark">#468faf</Color>
    <Color x:Key="BgInput">#bde0fe</Color>
    <Color x:Key="TextForeground">#012a4a</Color>
    <Color x:Key="TextOnDark">#FFFFFF</Color>
    <Color x:Key="PrimaryColor">#FF6200</Color>

    <!-- Кисти использующие эти цвета -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackground}" />
    <SolidColorBrush x:Key="BgSecondaryDarkBrush" Color="{StaticResource BgSecondaryDark}" />
    <SolidColorBrush x:Key="BgInputBrush" Color="{StaticResource BgInput}" />
    <SolidColorBrush x:Key="TextForegroundBrush" Color="{StaticResource TextForeground}" />
    <SolidColorBrush x:Key="TextOnDarkBrush" Color="{StaticResource TextOnDark}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />

    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource WindowBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextForegroundBrush}" />
    </Style>

    <Style x:Key="NavButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BgSecondaryDarkBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextOnDarkBrush}" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="Margin" Value="5" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

</ResourceDictionary>
