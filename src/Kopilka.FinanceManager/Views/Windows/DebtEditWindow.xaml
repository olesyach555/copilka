<Window x:Class="Kopilka.FinanceManager.Views.Windows.DebtEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Долг/Кредит" Height="450" Width="400" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Название:" Margin="0,0,0,5" />
            <TextBox x:Name="TitleBox" Padding="5" Margin="0,0,0,10" />

            <TextBlock Text="Сумма:" Margin="0,0,0,5" />
            <TextBox x:Name="PrincipalBox" Padding="5" Margin="0,0,0,10" />

            <TextBlock Text="Процентная ставка (%):" Margin="0,0,0,5" />
            <TextBox x:Name="RateBox" Padding="5" Margin="0,0,0,10" />

            <TextBlock Text="Контрагент:" Margin="0,0,0,5" />
            <TextBox x:Name="CounterpartyBox" Padding="5" Margin="0,0,0,10" />

            <TextBlock Text="Дата начала:" Margin="0,0,0,5" />
            <DatePicker x:Name="StartDatePicker" Margin="0,0,0,10" />

            <TextBlock Text="Дата окончания (опционально):" Margin="0,0,0,5" />
            <DatePicker x:Name="EndDatePicker" Margin="0,0,0,20" />

            <UniformGrid Columns="2">
                <Button Content="Сохранить" Click="Save_Click" Margin="5" Padding="10" />
                <Button Content="Отмена" Click="Cancel_Click" Margin="5" Padding="10" />
            </UniformGrid>
        </StackPanel>
    </Grid>
</Window>
