<Window x:Class="Kopilka.FinanceManager.Views.Windows.FamilyActionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Семья" Height="300" Width="400" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock x:Name="HeaderBlock" Text="Создать или присоединиться к семье" FontSize="16" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

            <TextBlock Text="Название семьи (для создания):" Margin="0,0,0,5" />
            <TextBox x:Name="FamilyNameBox" Padding="5" Margin="0,0,0,10" />

            <TextBlock Text="Домашний пароль:" Margin="0,0,0,5" />
            <TextBox x:Name="PasswordBox" Padding="5" Margin="0,0,0,20" />

            <UniformGrid Columns="2">
                <Button Content="Создать" Click="Create_Click" Margin="5" Padding="10" />
                <Button Content="Присоединиться" Click="Join_Click" Margin="5" Padding="10" />
            </UniformGrid>
            <Button Content="Отмена" Click="Cancel_Click" Margin="5,10,5,5" Padding="5" HorizontalAlignment="Center" Width="100"/>
        </StackPanel>
    </Grid>
</Window>
