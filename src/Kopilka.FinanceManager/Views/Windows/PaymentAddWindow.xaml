<Window x:Class="Kopilka.FinanceManager.Views.Windows.PaymentAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Внести платеж" Height="250" Width="300" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Сумма пополнения:" Margin="0,0,0,5" />
            <TextBox x:Name="AmountBox" Padding="5" Margin="0,0,0,20" />

            <UniformGrid Columns="2">
                <Button Content="ОК" Click="Ok_Click" Margin="5" Padding="10" />
                <Button Content="Отмена" Click="Cancel_Click" Margin="5" Padding="10" />
            </UniformGrid>
        </StackPanel>
    </Grid>
</Window>
