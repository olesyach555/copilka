<Window x:Class="Kopilka.FinanceManager.Views.Windows.TransactionEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Транзакция" Height="400" Width="400" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Сумма:" Margin="0,0,0,5" />
            <TextBox x:Name="AmountBox" Padding="5" Margin="0,0,0,10" />

            <TextBlock Text="Дата:" Margin="0,0,0,5" />
            <DatePicker x:Name="DatePicker" Margin="0,0,0,10" />

            <TextBlock Text="Категория:" Margin="0,0,0,5" />
            <ComboBox x:Name="CategoryCombo" DisplayMemberPath="Name" Margin="0,0,0,10" Padding="5" />

            <TextBlock Text="Комментарий:" Margin="0,0,0,5" />
            <TextBox x:Name="CommentBox" Padding="5" Margin="0,0,0,20" />

            <UniformGrid Columns="2">
                <Button Content="Сохранить" Click="Save_Click" Margin="5" Padding="10" />
                <Button Content="Отмена" Click="Cancel_Click" Margin="5" Padding="10" />
            </UniformGrid>
        </StackPanel>
    </Grid>
</Window>
