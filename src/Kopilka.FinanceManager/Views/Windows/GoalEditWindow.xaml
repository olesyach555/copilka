<Window x:Class="Kopilka.FinanceManager.Views.Windows.GoalEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Финансовая цель" Height="350" Width="400" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Название цели:" Margin="0,0,0,5" />
            <TextBox x:Name="NameBox" Padding="5" Margin="0,0,0,10" />

            <TextBlock Text="Целевая сумма:" Margin="0,0,0,5" />
            <TextBox x:Name="TargetBox" Padding="5" Margin="0,0,0,10" />

            <TextBlock Text="Целевая дата:" Margin="0,0,0,5" />
            <DatePicker x:Name="TargetDatePicker" Margin="0,0,0,10" />

            <CheckBox x:Name="IsFamilyCheck" Content="Общая семейная цель" Margin="0,0,0,20" />

            <UniformGrid Columns="2">
                <Button Content="Сохранить" Click="Save_Click" Margin="5" Padding="10" />
                <Button Content="Отмена" Click="Cancel_Click" Margin="5" Padding="10" />
            </UniformGrid>
        </StackPanel>
    </Grid>
</Window>
