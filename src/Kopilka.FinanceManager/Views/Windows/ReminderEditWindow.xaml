<Window x:Class="Kopilka.FinanceManager.Views.Windows.ReminderEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Напоминание" Height="350" Width="400" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Заголовок:" Margin="0,0,0,5" />
            <TextBox x:Name="TitleBox" Padding="5" Margin="0,0,0,10" />

            <TextBlock Text="Дата:" Margin="0,0,0,5" />
            <DatePicker x:Name="ReminderDatePicker" Margin="0,0,0,10" />

            <TextBlock Text="Категория транзакции (опц.):" Margin="0,0,0,5" />
            <ComboBox x:Name="CategoryCombo" DisplayMemberPath="Name" Margin="0,0,0,10" Padding="5" />

            <CheckBox x:Name="IsRecurringCheck" Content="Повторяющееся" Margin="0,0,0,20" />

            <UniformGrid Columns="2">
                <Button Content="Сохранить" Click="Save_Click" Margin="5" Padding="10" />
                <Button Content="Отмена" Click="Cancel_Click" Margin="5" Padding="10" />
            </UniformGrid>
        </StackPanel>
    </Grid>
</Window>
