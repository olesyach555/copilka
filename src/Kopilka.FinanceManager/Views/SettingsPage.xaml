<UserControl x:Class="Kopilka.FinanceManager.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Настройки профиля" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Логин:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock x:Name="LoginTextBlock" Margin="0,0,0,20" FontSize="16"/>

            <TextBlock Text="Email:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="EmailTextBox" Margin="0,0,0,20" FontSize="16" Padding="5"/>

            <Button x:Name="ChangePasswordButton" Content="Сменить пароль" Click="ChangePasswordButton_Click" HorizontalAlignment="Left" Width="200" Padding="10"/>

            <Button x:Name="SaveButton" Content="Сохранить изменения" Click="SaveButton_Click" HorizontalAlignment="Left" Width="200" Padding="10" Margin="0,20,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
