<UserControl x:Class="Kopilka.FinanceManager.Views.AccountsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Счета" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>

        <ListView Grid.Row="1" x:Name="AccountsListView" BorderThickness="0">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Balance, StringFormat='C'}" FontSize="16" Foreground="Gray"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Редактировать" x:Name="EditButton" Click="EditButton_Click" Margin="5"/>
                            <Button Content="Удалить" x:Name="DeleteButton" Click="DeleteButton_Click" Margin="5"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Button Grid.Row="2" x:Name="AddAccountButton" Content="Добавить счет" HorizontalAlignment="Right" Margin="0,10,0,0" Padding="10" Click="AddAccountButton_Click"/>
    </Grid>
</UserControl>
