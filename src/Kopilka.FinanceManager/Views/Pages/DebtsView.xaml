<UserControl x:Class="Kopilka.FinanceManager.Views.Pages.DebtsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Долги и кредиты" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" />
        <DataGrid Grid.Row="1" ItemsSource="{Binding Debts}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*" />
                <DataGridTextColumn Header="Сумма" Binding="{Binding Principal}" Width="100" />
                <DataGridTextColumn Header="Контрагент" Binding="{Binding Counterparty}" Width="150" />
                <DataGridTextColumn Header="Срок до" Binding="{Binding EndDate, StringFormat={}{0:dd.MM.yyyy}}" Width="100" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
