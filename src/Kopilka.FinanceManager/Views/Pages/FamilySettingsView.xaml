<UserControl x:Class="Kopilka.FinanceManager.Views.Pages.FamilySettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Настройки семьи" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" />

            <TextBlock Text="Название семьи:" Margin="0,10,0,5" />
            <TextBox Text="{Binding FamilyName}" Padding="5" />

            <TextBlock Text="Единый домашний пароль:" Margin="0,10,0,5" />
            <TextBox Text="{Binding HomePassword}" Padding="5" />

            <TextBlock Text="Участники:" Margin="0,20,0,10" FontWeight="Bold" />
            <DataGrid ItemsSource="{Binding FamilyMembers}" AutoGenerateColumns="False" IsReadOnly="True" Height="200">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="*" />
                    <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>

            <Button Content="Сохранить" Command="{Binding SaveSettingsCommand}" Margin="0,20,0,0" Padding="20,10" HorizontalAlignment="Left" />
        </StackPanel>
    </Grid>
</UserControl>
