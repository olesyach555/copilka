<UserControl x:Class="Kopilka.FinanceManager.Views.Pages.FamilySettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Настройки семьи" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" />

            <Border Visibility="{Binding HasFamily, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" Padding="20" Background="White" CornerRadius="10">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Вы еще не состоите в семье" Margin="0,0,0,10" HorizontalAlignment="Center" />
                    <Button Content="Создать или присоединиться" Command="{Binding ManageFamilyCommand}" Padding="20,10" />
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding HasFamily, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding FamilyName, StringFormat='Семья: {0}'}" FontSize="18" Margin="0,0,0,10" />

                <TextBlock Text="Участники:" FontWeight="Bold" Margin="0,10,0,5" />
                <ListBox ItemsSource="{Binding FamilyMembers}" DisplayMemberPath="Login" Height="150" Margin="0,0,0,20" />

                <Button Content="Выйти из семьи" Command="{Binding LeaveFamilyCommand}" Background="Red" Foreground="White" Width="150" HorizontalAlignment="Left" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
