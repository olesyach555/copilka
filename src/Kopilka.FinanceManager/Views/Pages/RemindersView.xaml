<UserControl x:Class="Kopilka.FinanceManager.Views.Pages.RemindersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Напоминания" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" />
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Reminders}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#f0f0f0" Margin="5" Padding="10" CornerRadius="5">
                        <DockPanel>
                            <CheckBox VerticalAlignment="Center" Margin="0,0,10,0" />
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                                <TextBlock Text="{Binding ReminderDate, StringFormat='Дата: {0:dd.MM.yyyy HH:mm}'}" FontSize="12" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
