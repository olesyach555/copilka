<Page x:Class="Kopilka.FinanceManager.Views.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Kopilka.FinanceManager.Views.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="HomePage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button x:Name="AddExpenseButton" Content="Расход" Style="{StaticResource ExpenseIncomeButtonStyle}" Click="AddExpenseButton_Click"/>
            <Button x:Name="AddIncomeButton" Content="Доход" Margin="10,0,0,0" Style="{StaticResource ExpenseIncomeButtonStyle}" Click="AddIncomeButton_Click"/>
        </StackPanel>

        <ListView Grid.Row="1" x:Name="TransactionsListView" Margin="10">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Дата" DisplayMemberBinding="{Binding Date, StringFormat='dd.MM.yyyy'}" Width="100"/>
                    <GridViewColumn Header="Тип" DisplayMemberBinding="{Binding Type}" Width="80"/>
                    <GridViewColumn Header="Категория" DisplayMemberBinding="{Binding Category.Name}" Width="120"/>
                    <GridViewColumn Header="Сумма" DisplayMemberBinding="{Binding Amount}" Width="100"/>
                    <GridViewColumn Header="Комментарий" DisplayMemberBinding="{Binding Comment}" Width="250"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Page>
