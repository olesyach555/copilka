<Page x:Class="Kopilka.FinanceManager.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SettingsPage">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="Настройки пользователя" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
            <TextBlock Text="Логин:" />
            <TextBlock x:Name="LoginTextBlock" Margin="0,5,0,10" FontWeight="SemiBold"/>
            <TextBlock Text="Email:" />
            <TextBox x:Name="EmailTextBox" Margin="0,5,0,10"/>
            <Button Content="Сохранить изменения" Style="{StaticResource PrimaryButton}" Click="SaveButton_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/>
            <Button Content="Изменить пароль" Style="{StaticResource SecondaryButton}" Click="ChangePasswordButton_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Page>
