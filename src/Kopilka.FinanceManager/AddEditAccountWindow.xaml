<Window x:Class="Kopilka.FinanceManager.AddEditAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Управление счетом" Height="400" Width="300"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="WindowTitle" Text="Добавить счет" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="Имя счета" Foreground="Gray" Margin="0,0,0,5"/>
            <TextBox x:Name="AccountNameTextBox" FontSize="18" Padding="5"/>

            <TextBlock Text="Начальный баланс" Foreground="Gray" Margin="0,20,0,5"/>
            <TextBox x:Name="AccountBalanceTextBox" FontSize="18" Padding="5" Text="0"/>
        </StackPanel>

        <Button Grid.Row="2" x:Name="SaveButton" Content="Сохранить" Click="SaveButton_Click" FontSize="18" Padding="10"/>
    </Grid>
</Window>
