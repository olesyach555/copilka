<Window x:Class="Kopilka.FinanceManager.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kopilka.FinanceManager"
        mc:Ignorable="d"
        Title="Копилка - Главная" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        Foreground="White"
        Closing="DashboardWindow_Closing">
    <Window.Resources>
        <Style TargetType="Button" x:Key="AddButton">
            <Setter Property="Background" Value="#FF6BBE9D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="30">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ... Стили ... -->
    </Window.Resources>

    <Grid Background="#FF1E3C30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20" Background="#FF2A5242">
             <TextBlock x:Name="TotalBalanceTextBlock" Text="... ₽" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"/>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель со счетами -->
            <Border Grid.Column="0" Background="#FF2A5242" Padding="10">
                <StackPanel>
                    <TextBlock Text="МОИ СЧЕТА" FontSize="16" FontWeight="Bold" Margin="5, 10" Opacity="0.8"/>
                    <ListView x:Name="AccountsListView" Background="Transparent" BorderThickness="0">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="5">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Balance, StringFormat={}{0:N2} ₽}" Opacity="0.7"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Content="Фильтр по дате" Click="DateFilterButton_Click" Margin="5,10"/>
                </StackPanel>
            </Border>

            <!-- Правая основная область -->
            <Grid Grid.Column="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                 <TabControl Grid.Row="1" x:Name="MainTabControl" BorderThickness="0" Background="Transparent" SelectionChanged="MainTabControl_SelectionChanged">
                    <TabItem Header="РАСХОДЫ">
                        <Grid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="За выбранный период расходов:" FontSize="18" Opacity="0.8"/>
                                <TextBlock x:Name="ExpensesTextBlock" Text="... ₽" FontSize="48" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                    <TabItem Header="ДОХОДЫ">
                        <Grid>
                             <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="За выбранный период доходов:" FontSize="18" Opacity="0.8"/>
                                <TextBlock x:Name="IncomeTextBlock" Text="... ₽" FontSize="48" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                </TabControl>
                <Button Style="{StaticResource AddButton}" Content="+"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="30"
                        Click="AddTransactionButton_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
