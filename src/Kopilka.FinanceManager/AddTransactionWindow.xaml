<Window x:Class="Kopilka.FinanceManager.AddTransactionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kopilka.FinanceManager"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Добавление операции" Height="700" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource MainBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}">
    <Window.Resources>
        <!-- Стили для вкладок -->
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" BorderThickness="0,0,0,2" BorderBrush="Transparent" Margin="5">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,5"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Стиль для кнопок категорий -->
        <Style TargetType="Button" x:Key="CategoryButton">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="80"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="{StaticResource SecondaryAccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="40">
                            <TextBlock Text="{TemplateBinding Content}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и вкладки -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Добавление операции" Style="{StaticResource HeaderTextStyle}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            <TabControl x:Name="TransactionTypeTabControl" Grid.Row="0" Margin="10" Background="Transparent" BorderThickness="0" SelectionChanged="TransactionTypeTabControl_SelectionChanged">
                <TabItem Header="РАСХОДЫ"/>
                <TabItem Header="ДОХОДЫ"/>
            </TabControl>
        </StackPanel>

        <!-- Основной контент -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,0">
                <!-- Ввод суммы -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBox x:Name="AmountTextBox" FontSize="48" Text="0" Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="{StaticResource PrimaryTextBrush}" Foreground="{StaticResource PrimaryTextBrush}" Width="200" TextAlignment="Right"/>
                    <TextBlock Text="RUB" FontSize="32" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <!-- Счет -->
                <TextBlock Text="Счет" Style="{StaticResource CaptionTextStyle}" Margin="0,20,0,5"/>
                <ComboBox x:Name="AccountComboBox" Margin="0,0,0,10"/>

                <!-- Категории -->
                <TextBlock Text="Категории" Style="{StaticResource CaptionTextStyle}" Margin="0,10,0,5"/>
                <ItemsControl x:Name="CategoryItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Name}" Style="{StaticResource CategoryButton}" Click="CategoryButton_Click"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Дата -->
                <StackPanel Orientation="Horizontal" Margin="0,20,0,5">
                    <Button x:Name="TodayButton" Content="Сегодня" Click="TodayButton_Click"/>
                    <Button x:Name="YesterdayButton" Content="Вчера" Margin="10,0" Click="YesterdayButton_Click"/>
                    <DatePicker x:Name="DatePicker" SelectedDate="{x:Static sys:DateTime.Now}"/>
                </StackPanel>

                <!-- Комментарий -->
                <TextBlock Text="Комментарий" Style="{StaticResource CaptionTextStyle}" Margin="0,10,0,5"/>
                <TextBox x:Name="CommentTextBox" MinHeight="40" TextWrapping="Wrap" AcceptsReturn="True"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Кнопка "Добавить" -->
        <Button x:Name="AddButton" Grid.Row="2" Content="Добавить" FontSize="20" FontWeight="Bold" Margin="20" Padding="15" Click="AddButton_Click"/>
    </Grid>
</Window>
