<Window x:Class="Kopilka.FinanceManager.AddTransactionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kopilka.FinanceManager"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Добавить транзакцию" Height="400" Width="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Сумма:"/>
            <TextBox x:Name="AmountTextBox" Margin="0,5,0,10"/>

            <TextBlock Text="Категория:"/>
            <ComboBox x:Name="CategoryComboBox" Margin="0,5,0,10"/>

            <TextBlock Text="Счет:"/>
            <ComboBox x:Name="AccountComboBox" Margin="0,5,0,10"/>

            <TextBlock Text="Дата:"/>
            <DatePicker x:Name="DatePicker" Margin="0,5,0,10" SelectedDate="{x:Static sys:DateTime.Now}"/>

            <Button Content="Добавить" Click="AddButton_Click" Margin="0,20,0,0"/>
        </StackPanel>
    </Grid>
</Window>
